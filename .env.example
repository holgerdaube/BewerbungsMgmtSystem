# Beispiel-Konfiguration fuer das Bewerbungs-Management-System (Backend).
# Kopieren als .env im Projekt-Root, nur bei Abweichung vom Default befuellen.
# Diese Werte werden von backend/run_server.py, backend/app/db.py und
# backend/app/agent_runner.py per os.environ gelesen (Defaults stehen dort im Code).
#
# API-Secrets (APIFY_TOKEN, CLAUDE_CODE_OAUTH_TOKEN) gehoeren NICHT hierher,
# sondern in agent.env im Secrets-Verzeichnis (s. BMS_SECRETS_DIR unten) — Vorlage siehe
# automation/agent.env.example.

# Server-Bind-Adresse (Default 127.0.0.1; 0.0.0.0 nur im vertrauten WLAN, s. start_lan.command)
HOST=

# Server-Port (Default 8000)
PORT=

# Wurzelordner fuer data/, z. B. fuer Tests mit isolierten Daten (Default: Projekt-Root/data)
BMS_DATA_DIR=

# Verzeichnis fuer Gmail-Secrets + agent.env, AUSSERHALB von Projekt & iCloud (Phase 63A,
# Default ~/.bewerbung_mgmt_secrets — Verzeichnis chmod 700, Dateien chmod 600)
BMS_SECRETS_DIR=

# Pfad/Name der claude-Binary fuer headless Agent-Laeufe (Default: "claude")
CLAUDE_BIN=

# Timeout je Agent-Task in Sekunden (Default 1800)
AGENT_TASK_TIMEOUT=

# Maximal parallele Agent-Tasks (Default 2)
AGENT_MAX_PARALLEL=

# Notbremse je Agent-Lauf in USD-Aequivalent, leer schaltet sie aus (Default 15.00)
AGENT_MAX_BUDGET_USD=

# Tagesbudget-Fallback in USD-Aequivalent, 0 = deaktiviert (Default 100, s. BudgetLimit in der DB)
AGENT_DAILY_BUDGET_USD=

# Maximale Agent-Laeufe pro Tag, reiner Kaskaden-/Endlos-Loop-Schutz (Default 100)
AGENT_MAX_TASKS_PER_DAY=

# Aufbewahrung der Agent-Logs in Tagen (Default 30)
AGENT_LOG_RETENTION_DAYS=
